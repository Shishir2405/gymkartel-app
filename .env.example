# GraphQL API endpoint. Codegen reads the schema from the linked contract
# package on disk, so this is only needed at runtime for the urql client.
GRAPHQL_URL=https://api.gymkartel.app/graphql

# Publishable Razorpay key id (safe on-device; the secret stays server-side).
# Consumed via app.config.ts -> extra.razorpayKeyId. Needs a native dev build.
RAZORPAY_KEY_ID=

# Google Maps SDK key for Android (react-native-maps). iOS uses Apple Maps and
# needs no key. Consumed via app.config.ts -> android.config.googleMaps.apiKey.
GOOGLE_MAPS_ANDROID_API_KEY=
